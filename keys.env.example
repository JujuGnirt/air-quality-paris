# =====================================================================
# TEMPLATE of the secrets file — this file contains NO real value.
#
# 1. Create a folder  secrets/  at the root of the project.
# 2. Copy this file into it under the name  keys.env :  secrets/keys.env
# 3. Fill in the values after the = sign (no spaces, no quotes).
#
# secrets/ is in .gitignore: secrets/keys.env will never go to GitHub.
# The scripts read it automatically (see src/config.py).
# =====================================================================

# Météo-France API "Données Publiques Climatologie": fill in ONE of the two lines
# https://portail-api.meteofrance.fr/web/fr/api/DonneesPubliquesClimatologie
METEOFRANCE_API_KEY=
METEOFRANCE_APPLICATION_ID=

# MySQL
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=air_quality_paris

# Key protecting the Flask API (src/api_flask.py): any long random text.
# To generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
